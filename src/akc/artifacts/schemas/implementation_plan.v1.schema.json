{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akc:implementation_plan:v1",
  "title": "AKC practical backend implementation plan",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "schema_id": {
      "type": "string",
      "default": "akc:implementation_plan:v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_runtime_plugin": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "seed_steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "run_id",
    "tenant_id",
    "repo_id",
    "selected_runtime_plugin",
    "phases",
    "seed_steps"
  ]
}
